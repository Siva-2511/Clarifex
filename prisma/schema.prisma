generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String          @default("user")
  mfaEnabled    Boolean         @default(false)
  mfaSecret     String?
  firstLogin    Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  accounts      Account[]
  sessions      Session[]
  documents     Document[]
  analyses      Analysis[]
  auditLogs     AuditLog[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Document {
  id            String   @id @default(cuid())
  userId        String
  name          String
  type          String   // pdf, docx, txt, screenshot, url, paste
  storageKey    String
  sizeBytes     Int
  checksum      String   // SHA-256
  jurisdiction  String?  @default("US-General")
  language      String?  @default("en")
  extractedText String   @db.Text
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([checksum])
  @@index([createdAt])
}

model Analysis {
  id                 String          @id @default(cuid())
  documentIds        String[]
  userId             String
  status             String          @default("pending") // pending, processing, completed, failed
  modelUsed          String          @default("google/gemini-flash-1.5")
  comprehensionLevel String          @default("eli-10") // eli-5, eli-10, expert
  resultJson         Json?
  riskScore          Float?          @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]
  checklists     Checklist[]
  collaborations Collaboration[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Message {
  id         String   @id @default(cuid())
  analysisId String
  role       String   // user, assistant, system
  content    String   @db.Text
  citations  Json?    // Array of { clause, pageRef, reason }
  createdAt  DateTime @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([createdAt])
}

model Checklist {
  id         String   @id @default(cuid())
  analysisId String
  items      Json     // Array of { id, category, label, checked, importance, explanation }
  createdAt  DateTime @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model Collaboration {
  id           String    @id @default(cuid())
  analysisId   String
  inviteeEmail String
  accessToken  String    @unique
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([inviteeEmail])
  @@index([accessToken])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
